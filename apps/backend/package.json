{
    "name": "backend",
    "version": "1.0.4",
    "scripts": {
        "test": "NODE_ENV=test bun --env-file=.env.test test src/test",
        "dev": "bun run --watch src/app.ts",
        "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server src/app.ts",
        "db:push": "bunx drizzle-kit push",
        "db:gen": "bunx drizzle-kit generate",
        "db:migrate": "bun --no-env-file run src/lib/db/migrate.ts",
        "db:reset": "bun --no-env-file run src/lib/db/reset/index.ts",
        "db:seed": "bun --no-env-file run src/lib/db/seed/index.ts"
    },
    "dependencies": {
        "@elysiajs/cors": "^1.4.1",
        "@elysiajs/openapi": "^1.4.14",
        "@z3-wallet/exception": "workspace:*",
        "@z3-wallet/types": "workspace:*",
        "@z3-wallet/utils": "workspace:*",
        "drizzle-orm": "^0.45.1",
        "elysia": "latest",
        "elysia-prometheus": "^1.1.1",
        "pg": "^8.18.0",
        "winston": "^3.19.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.15",
        "@types/pg": "^8.16.0",
        "bun-types": "1.3.9",
        "drizzle-kit": "^0.31.9",
        "turbo": "^2.8.10"
    }
}

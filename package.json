{
    "name": "z3-wallet-monorepo",
    "version": "1.0.5",
    "devDependencies": {
        "turbo": "^2.8.10"
    },
    "packageManager": "bun@1.3.9",
    "private": true,
    "scripts": {
        "clean": "rimraf node_modules apps/*/node_modules apps/*/bun.lock bun.lock",
        "build": "turbo run build",
        "build:web": "turbo run build --filter=web",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "check-types": "turbo run check-types",
        "test": "turbo run test",
        "verify:predeploy": "bun install --frozen-lockfile && bun run lint && bun run check-types && bun run test && bun run build",
        "release:prepare": "bun run verify:predeploy",
        "release:bump": "bun run ./scripts/release/bump-version.mjs",
        "release:tag": "bun run ./scripts/release/tag-current-version.mjs",
        "release:deploy:web": "bun run --cwd apps/web cf:deploy",
        "release:deploy": "bun run release:deploy:web"
    },
    "workspaces": [
        "apps/web",
        "apps/backend",
        "packages/types",
        "packages/api-client",
        "packages/exception",
        "packages/utils"
    ]
}

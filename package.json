{
    "name": "z3-wallet-monorepo",
    "private": true,
    "version": "1.0.0",
    "workspaces": [
        "apps/web",
        "apps/backend",
        "packages/types",
        "packages/api-client",
        "packages/exception",
        "packages/utils"
    ],
    "devDependencies": {
        "turbo": "^2.8.10"
    },
    "scripts": {
        "clean": "rimraf node_modules apps/*/node_modules apps/*/bun.lock bun.lock",
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "check-types": "turbo run check-types",
        "test": "turbo run test",
        "verify:env": "bun run ./scripts/predeploy/env-preflight.ts",
        "verify:predeploy": "bun install --frozen-lockfile && bun run verify:env && bun run lint && bun run check-types && bun run test && bun run build"
    },
    "packageManager": "bun@1.3.9"
}
